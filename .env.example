# Copy to .env for local `npm run dev`.
# Render: set only the required keys in the dashboard. Optional keys use the
# defaults below if you leave them unset.

# --- required ---
GEMINI_API_KEY=

# --- recommended in production ---
# Vercel origin allowed to call this API (no trailing slash).
CORS_ORIGIN=https://ledger-lens-demo.vercel.app

# --- optional (defaults are used if omitted) ---
PORT=3001
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_MS=25000
GEMINI_PING_TIMEOUT_MS=15000
GEMINI_RETRIES=4
GEMINI_RETRY_MS=2500
GEMINI_MAX_CHARS=8000
MAX_UPLOAD_MB=10
