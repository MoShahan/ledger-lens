PORT=3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000
MAX_UPLOAD_MB=10
# Comma-separated browser origins allowed to call the API (Vercel URL in production).
# Leave empty to allow any origin. Local Vite (localhost:5173) is always allowed.
CORS_ORIGIN=https://ledger-lens-demo.vercel.app